# ============================================================
# ThyroConsult Backend — Environment Configuration
# Copy this file to .env and fill in all values before running
# NEVER commit .env to version control
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thyroconsult
DB_USER=thyroconsult_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Encryption (HIPAA AES-256) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_KEY_HERE
ENCRYPTION_IV_LENGTH=16
PHI_ENCRYPTION_KEY=GENERATE_SEPARATE_32_BYTE_HEX_KEY_HERE
PHOTO_ENCRYPTION_KEY=GENERATE_SEPARATE_32_BYTE_HEX_KEY_HERE

# --- JWT Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_64_BYTE_HEX_SECRET_HERE
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_BYTE_HEX_SECRET_HERE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- File Storage (local for dev, S3 for production) ---
STORAGE_TYPE=local
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5

# AWS S3 (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=thyroconsult-documents
AWS_KMS_KEY_ID=

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# --- Twilio (SMS + WhatsApp OTP) ---
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Email (SendGrid or SMTP) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@thyroidcare.in
SMTP_PASSWORD=CHANGE_THIS
EMAIL_FROM_NAME=ThyroConsult
EMAIL_FROM_ADDRESS=noreply@thyroidcare.in

# --- OTP Configuration ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_MINUTES=1

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_MINUTES=30

# --- Session & Security ---
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# --- HIPAA Audit Log ---
AUDIT_LOG_RETENTION_DAYS=2190
AUDIT_LOG_PATH=./logs/audit

# --- Admin ---
ADMIN_EMAIL=admin@thyroidcare.in
ADMIN_INITIAL_PASSWORD=CHANGE_ON_FIRST_LOGIN

# --- Consultation Fees ---
DEFAULT_CONSULTATION_FEE=1200
PLATFORM_FEE=50
GST_RATE=0.18

# --- Invoice ---
INVOICE_PREFIX=INV
COMPANY_NAME=ThyroConsult Healthcare Pvt. Ltd.
COMPANY_ADDRESS=Pune, Maharashtra, India
COMPANY_GSTIN=27XXXXX0000X1ZX
